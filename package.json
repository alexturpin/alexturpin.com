{
  "name": "alexturpin-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @alexturpin/site dev",
    "dev:site": "pnpm --filter @alexturpin/site dev",
    "dev:pds": "pnpm --filter @alexturpin/pds dev",
    "preview": "pnpm --filter @alexturpin/site preview",
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "pnpm -r run lint",
    "lint:fix": "pnpm -r run lint:fix",
    "test": "pnpm -r --if-present run test",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "validate": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "cf:typegen": "pnpm -r run cf:typegen",
    "atproto:preview": "pnpm --filter @alexturpin/site atproto:preview",
    "atproto:publish": "pnpm --filter @alexturpin/site atproto:publish",
    "deploy:site": "pnpm --filter @alexturpin/site deploy",
    "deploy:pds": "pnpm --filter @alexturpin/pds deploy"
  },
  "devDependencies": {
    "oxfmt": "0.78.0"
  },
  "engines": {
    "node": ">=26.13.0 <27"
  },
  "packageManager": "pnpm@11.25.0"
}

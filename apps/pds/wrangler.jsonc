{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "alexturpin-pds",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-10",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [{ "name": "ACCOUNT", "class_name": "AccountDurableObject" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AccountDurableObject"] }],
  "r2_buckets": [{ "binding": "BLOBS", "bucket_name": "alexturpin-pds-blobs" }],
  "vars": {
    // Local test identity only; production identity and hostname are not configured.
    "DID": "did:web:localhost",
    "HANDLE": "pds.example.test",
    "PDS_HOSTNAME": "localhost:8787",
    "INITIAL_ACTIVE": "false",
  },
  "observability": {
    "enabled": true,
    "traces": { "enabled": true, "head_sampling_rate": 0.01 },
  },
}
